// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


/// Appointment — Scheduled patient-doctor appointment
model Appointment {
  /// Unique auto-incremented appointment identifier
  appointment_id     Int      @id @default(autoincrement())
  /// FK to Patient — the patient this appointment is for
  patient_id         Int
  /// FK to Doctor — the attending doctor
  doctor_id          String
  /// Date of the appointment
  appointment_date   DateTime
  /// Scheduled start time
  start_time         DateTime
  /// Scheduled end time
  end_time           DateTime
  /// Duration in minutes (optional, derived from start/end)
  duration           Int?
  /// Type of appointment (e.g., "Consultation", "Follow-up", "Procedure")
  appointment_type   String
  /// Patient's reason for visiting
  reason_for_visit   String?
  /// Workflow status (e.g., "scheduled", "checked_in", "completed", "cancelled")
  appointment_status String
  /// Additional notes for the appointment
  notes              String?

  // Snapshot fields (denormalized for reporting/search)
  /// Patient MRN snapshot at booking time
  patient_mrn       String
  /// Patient title snapshot (Mr/Mrs/Dr)
  patient_title     String
  /// Patient first name snapshot
  patient_firstName String
  /// Patient last name snapshot
  patient_lastName  String
  /// Doctor title snapshot
  doctor_title      String
  /// Doctor first name snapshot
  doctor_firstName  String
  /// Doctor last name snapshot
  doctor_lastName   String
  /// Doctor specialty snapshot
  doctor_specialty  String

  /// Record status: 1 = active, 0 = inactive/cancelled
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patient       Patient         @relation(fields: [patient_id], references: [patient_id])
  doctor        Doctor          @relation(fields: [doctor_id], references: [id])
  visits        Visit[]
  clinicalNotes ClinicalNotes[]
  prescriptions Prescription[]

  @@index([patient_id])
  @@index([doctor_id])
  @@index([appointment_date])
  @@index([status])
}


// Billing Models: Invoice, InvoiceItem, Receipt

/// Invoice — Billing invoice for a patient visit
model Invoice {
    /// Unique auto-incremented invoice identifier
    invoice_id     Int    @id @default(autoincrement())
    /// Invoice number (unique, e.g., "INV-0001")
    invoice_number String @unique
    /// FK to Patient
    patient_id     Int
    /// FK to Visit
    visit_id       Int

    // Totals (calculated)
    /// Sum of all line item amounts before discounts
    gross_total     Decimal @default(0)
    /// Discount type: "percentage" or "fixed"
    discount_type   String  @default("percentage")
    /// Discount value (percentage or fixed amount)
    discount_value  Decimal @default(0)
    /// Calculated discount amount in currency
    discount_amount Decimal @default(0)
    /// Calculated tax amount
    tax_amount      Decimal @default(0)
    /// Final total after discounts and tax
    net_total       Decimal @default(0)

    // Additional fields
    /// Applied coupon code (optional)
    coupon_code            String?
    /// Calculated discount from coupon
    coupon_discount_amount Decimal   @default(0)
    /// Reason for applying discount
    discount_reason        String?
    /// Invoice issue date
    invoice_date           DateTime  @default(now())
    /// Payment due date (optional)
    due_date               DateTime?
    /// Additional invoice notes
    notes                  String?

    /// Invoice workflow status: "draft", "sent", "paid", "cancelled"
    status String @default("draft")

    /// Timestamp when the record was created
    createdAt DateTime  @default(now())
    /// User ID who created this record
    createdBy String?
    /// Timestamp of last update
    updatedAt DateTime  @updatedAt
    /// User ID who last updated this record
    updatedBy String?
    /// Soft-delete timestamp (null = not deleted)
    deletedAt DateTime?
    /// User ID who soft-deleted this record
    deletedBy String?

    // Relations
    patient  Patient       @relation(fields: [patient_id], references: [patient_id])
    visit    Visit         @relation(fields: [visit_id], references: [visit_id])
    items    InvoiceItem[]
    receipts Receipt[]

    @@index([patient_id])
    @@index([visit_id])
    @@index([invoice_number])
    @@index([status])
    @@index([invoice_date])
    @@index([createdAt])
    @@index([deletedAt])
}

/// InvoiceItem — Line item on an invoice
model InvoiceItem {
    /// Unique auto-incremented item identifier
    item_id    Int @id @default(autoincrement())
    /// FK to parent Invoice
    invoice_id Int

    /// Item category: "drug", "procedure", "package", or "custom"
    item_type    String
    /// Display name of the item
    item_name    String
    /// FK to source master record (drug_id, procedure_id, etc.) — optional for custom items
    reference_id Int?

    // Pricing
    /// Quantity of this item
    quantity        Int     @default(1)
    /// Unit price per item
    unit_amount     Decimal @default(0)
    /// Premium/markup amount
    premium         Decimal @default(0)
    /// Line-item discount type: "percentage" or "fixed"
    discount_type   String  @default("percentage")
    /// Line-item discount value
    discount_value  Decimal @default(0)
    /// Calculated line-item discount amount
    discount_amount Decimal @default(0)
    /// Whether tax applies to this item
    tax_applicable  Boolean @default(false)
    /// Calculated net amount for this line item
    net_amount      Decimal @default(0)

    /// Additional notes for this line item
    notes         String?
    /// User/staff assigned to this item (optional)
    assigned_user String?

    /// Timestamp when the record was created
    createdAt DateTime @default(now())
    /// Timestamp of last update
    updatedAt DateTime @updatedAt

    // Relations
    invoice Invoice @relation(fields: [invoice_id], references: [invoice_id], onDelete: Cascade)

    @@index([invoice_id])
    @@index([item_type])
    @@index([reference_id])
}

/// Receipt — Payment receipt against an invoice
model Receipt {
    /// Unique auto-incremented receipt identifier
    receipt_id     Int    @id @default(autoincrement())
    /// Receipt number (unique, e.g., "RCP-0001")
    receipt_number String @unique
    /// FK to Invoice this payment is for
    invoice_id     Int
    /// FK to Patient
    patient_id     Int

    /// Payment amount
    amount         Decimal
    /// Payment method: "cash", "card", "upi", "bank_transfer", "other"
    payment_method String
    /// Date and time of payment
    payment_date   DateTime @default(now())
    /// Additional payment notes
    notes          String?

    /// Record status: 1 = active, 0 = inactive
    status    Int       @default(1)
    /// Timestamp when the record was created
    createdAt DateTime  @default(now())
    /// User ID who created this record
    createdBy String?
    /// Timestamp of last update
    updatedAt DateTime  @updatedAt
    /// User ID who last updated this record
    updatedBy String?
    /// Soft-delete timestamp (null = not deleted)
    deletedAt DateTime?
    /// User ID who soft-deleted this record
    deletedBy String?

    // Relations
    invoice Invoice @relation(fields: [invoice_id], references: [invoice_id])
    patient Patient @relation(fields: [patient_id], references: [patient_id])

    @@index([invoice_id])
    @@index([patient_id])
    @@index([receipt_number])
    @@index([status])
    @@index([payment_date])
    @@index([createdAt])
    @@index([deletedAt])
}


/// Doctor — Medical practitioner profile
model Doctor {
    /// Unique UUID identifier for the doctor
    id           String   @id @default(uuid())
    /// Title (e.g., "Dr.", "Prof.")
    title        String
    /// First name
    firstName    String
    /// Last name
    lastName     String
    /// Date of birth
    dob          DateTime
    /// Email address (unique)
    email        String   @unique
    /// Medical licence number (unique)
    licenceNo    String   @unique
    /// Academic degree (e.g., "MBBS", "MDS")
    degree       String
    /// Medical specialty (e.g., "General Dentistry", "Orthodontics")
    specialty    String
    /// Appointment time block duration (e.g., "5min", "10min", "15min", "30min", "1hr")
    timeBlock    String?
    /// Display name shown in UI and reports
    displayName  String
    /// Hex color code for calendar/UI display (e.g., "#4f46e5")
    displayColor String

    /// Street address
    address String?
    /// Area / locality
    area    String?
    /// City
    city    String?
    /// State / province
    state   String?
    /// Country
    country String?
    /// Postal / PIN code
    pincode String?

    /// Record status: 1 = active, 0 = inactive
    status Int @default(1)

    /// Timestamp when the record was created
    createdAt DateTime  @default(now())
    /// User ID who created this record
    createdBy String?
    /// Timestamp of last update
    updatedAt DateTime  @updatedAt
    /// User ID who last updated this record
    updatedBy String?
    /// Soft-delete timestamp (null = not deleted)
    deletedAt DateTime?
    /// User ID who soft-deleted this record
    deletedBy String?

    // Relations
    appointments  Appointment[]
    visits        Visit[]
    patientInfo   PatientInfo[]
    clinicalNotes ClinicalNotes[]
    prescriptions Prescription[]
    dentalHPIs    DentalHPI[]

    @@index([email])
    @@index([licenceNo])
    @@index([specialty])
    @@index([status])
    @@index([createdAt])
    @@index([deletedAt])
}


// Master data models: Insurance, Allergy, Location, Drug, DocumentType

/// Insurance — Insurance policy master record
model Insurance {
  /// Unique auto-incremented identifier
  i_id           Int      @id @default(autoincrement())
  /// Insurance type (e.g., "Health", "Dental", "Life")
  type           String
  /// Insurance company name
  company        String
  /// Policy plan name
  policy         String
  /// Policy number
  policyNo       String
  /// Policy validity start date
  validationFrom DateTime
  /// Policy validity end date
  validationTo   DateTime
  /// Additional notes
  notes          String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Allergy — Allergy master record
model Allergy {
  /// Unique auto-incremented allergy identifier
  allergy_id  Int    @id @default(autoincrement())
  /// Name of the allergy (e.g., "Penicillin", "Peanuts")
  allergyName String
  /// Category/type of allergy (e.g., "Drug", "Food", "Environmental")
  allergyType String

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patientAllergies PatientAllergy[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Location — Clinic/branch location
model Location {
  /// Unique auto-incremented location identifier
  location_id   Int             @id @default(autoincrement())
  /// Location/branch name
  location_name String
  /// Street address
  address       String?
  /// City
  city          String
  /// State / province
  state         String
  clinicalNotes ClinicalNotes[]

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Whether the location is currently active (boolean flag)
  active    Boolean   @default(true)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  @@index([status])
  @@index([active])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Drug — Drug/medication master record
model Drug {
  /// Unique auto-incremented drug identifier
  drug_id      Int     @id @default(autoincrement())
  /// Generic/chemical name of the drug
  drug_generic String
  /// Brand/trade name of the drug
  drug_name    String
  /// Type of drug (e.g., "Tablet", "Capsule", "Syrup", "Injection")
  drug_type    String
  /// Dosage strength (e.g., "500", "250")
  drug_dosage  String
  /// Unit of measure (e.g., "mg", "ml", "g")
  drug_measure String
  /// Price per unit
  amount       Decimal @default(0)
  /// Default usage instructions (e.g., "Take after food")
  instruction  String?

  prescriptions         Prescription[]         @relation("PrescriptionDrug")
  prescriptionTemplates PrescriptionTemplate[] @relation("PrescriptionTemplateDrug")

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// DocumentType — Master list of document types for visit uploads
model DocumentType {
  /// Unique auto-incremented identifier
  document_type_id Int     @id @default(autoincrement())
  /// Document type name (e.g., "X-Ray", "Lab Report", "Consent Form") — unique
  type_name        String  @unique
  /// Description of the document type
  description      String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visitDocuments VisitDocument[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}


/// Patient — Core patient demographic record
model Patient {
  /// Unique auto-incremented patient identifier
  patient_id    Int       @id @default(autoincrement())
  /// Medical Record Number — unique across the system
  mrn           String    @unique
  /// Title (e.g., "Mr", "Mrs", "Dr")
  title         String
  /// First name
  firstName     String
  /// Last name
  lastName      String
  /// Date of birth (optional)
  dateOfBirth   DateTime?
  /// Age in years (may be manually entered if DOB unknown)
  age           Int?
  /// Gender (e.g., "Male", "Female", "Other")
  gender        String
  /// Primary mobile/phone number
  mobileNumber  String
  /// Street address
  address       String
  /// Area / locality
  area          String
  /// City
  city          String
  /// State / province
  state         String
  /// Country
  country       String
  /// Postal / PIN code
  pincode       String
  /// Aadhaar number (Indian national ID, optional)
  aadhar        String?
  /// Referral source (e.g., "Walk-in", "Doctor referral", "Online")
  referalSource String?
  /// General comments or notes about the patient
  comments      String?
  /// Record status: 1 = active, 0 = inactive
  activeStatus  Int       @default(1)
  /// Timestamp when the record was created
  createdAt     DateTime  @default(now())
  /// User ID who created this record
  createdBy     String
  /// Timestamp of last update
  updatedAt     DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy     String

  // Relations
  appointments     Appointment[]
  visits           Visit[]
  patientAllergies PatientAllergy[]
  patientInfo      PatientInfo?
  patientEmergency PatientEmergency[]
  clinicalNotes    ClinicalNotes[]
  prescriptions    Prescription[]
  visitDocuments   VisitDocument[]
  dentalHPIs       DentalHPI[]
  invoices         Invoice[]
  receipts         Receipt[]
}

/// PatientAllergy — Records a patient's allergy information
model PatientAllergy {
  /// Unique auto-incremented identifier
  id          Int     @id @default(autoincrement())
  /// FK to Patient
  patient_id  Int
  /// FK to Allergy master (optional if custom allergy name)
  allergy_id  Int?
  /// Name of the allergy (may differ from master if custom)
  allergyName String
  /// Additional notes about the allergy
  notes       String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patient Patient  @relation(fields: [patient_id], references: [patient_id])
  allergy Allergy? @relation(fields: [allergy_id], references: [allergy_id])

  @@index([patient_id])
  @@index([allergy_id])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// PatientInfo — Extended patient information (one-to-one with Patient)
model PatientInfo {
  /// Unique auto-incremented identifier
  pi_id           Int       @id @default(autoincrement())
  /// FK to Patient (unique — one record per patient)
  patient_id      Int       @unique
  /// Blood group (e.g., "A+", "O-", "AB+")
  bloodGroup      String
  /// Whether the patient is an overseas/international patient
  overseas        Boolean
  /// Passport number (for overseas patients)
  passportNumber  String?
  /// Passport validity date
  validityDate    DateTime?
  /// Patient's occupation
  occupation      String?
  /// Department (if employed)
  department      String?
  /// Company / employer name
  companyName     String?
  /// Job designation / title
  designation     String?
  /// Employee code / ID
  employeeCode    String?
  /// FK to Doctor — the patient's primary/assigned doctor
  primaryDoctorId String?
  /// Record status: 1 = active, 0 = inactive
  activeStatus    Int       @default(1)
  /// Timestamp when the record was created
  createdAt       DateTime  @default(now())
  /// User ID who created this record
  createdBy       String?
  /// Timestamp of last update
  updatedAt       DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy       String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt       DateTime?
  /// User ID who soft-deleted this record
  deletedBy       String?

  patient Patient @relation(fields: [patient_id], references: [patient_id])
  doctor  Doctor? @relation(fields: [primaryDoctorId], references: [id])

  @@index([patient_id])
  @@index([primaryDoctorId])
  @@index([activeStatus])
}

/// PatientEmergency — Emergency contact for a patient
model PatientEmergency {
  /// Unique auto-incremented identifier
  pe_id         Int       @id @default(autoincrement())
  /// FK to Patient
  patient_id    Int
  /// Emergency contact person's name
  name          String
  /// Relationship to patient (e.g., "Spouse", "Parent", "Sibling")
  relation      String
  /// Emergency contact phone number
  contactNumber String
  /// Record status: 1 = active, 0 = inactive
  status        Int       @default(1)
  /// Timestamp when the record was created
  createdAt     DateTime  @default(now())
  /// User ID who created this record
  createdBy     String?
  /// Timestamp of last update
  updatedAt     DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy     String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt     DateTime?
  /// User ID who soft-deleted this record
  deletedBy     String?

  patient Patient @relation(fields: [patient_id], references: [patient_id])

  @@index([patient_id])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}


/// User — System user account
model User {
    /// Unique UUID identifier
    userId      String  @id @default(uuid())
    /// Title (e.g., "Mr", "Mrs", "Dr")
    title       String
    /// Full display name
    fullName    String
    /// First name
    firstName   String
    /// Last name
    lastName    String
    /// Email address (unique, used for login)
    email       String  @unique
    /// Phone number (optional)
    phoneNumber String?
    /// FK to Group — role/permission group (null for root user)
    groupId     String?
    /// Hashed password
    password    String

    /// FK to parent User — for hierarchical user management
    parentId    String?
    /// Account type: "root" or "child"
    accountType String  @default("child")

    /// Timestamp when the record was created
    createdAt DateTime @default(now())
    /// User ID who created this record
    createdBy String?
    /// Timestamp of last update
    updatedAt DateTime @updatedAt
    /// User ID who last updated this record
    updatedBy String?

    /// Account status: 1 = active, 0 = inactive
    userStatus Int       @default(1)
    /// Date of birth (optional)
    dob        DateTime?
    /// One-time password for verification/reset
    otp        String?
    /// OTP expiry timestamp
    otpExpiry  DateTime?

    group Group? @relation(fields: [groupId], references: [id])

    parent   User?  @relation("ParentChild", fields: [parentId], references: [userId])
    children User[] @relation("ParentChild")

    creator      User?  @relation("UserCreator", fields: [createdBy], references: [userId])
    createdUsers User[] @relation("UserCreator")

    updater      User?  @relation("UserUpdater", fields: [updatedBy], references: [userId])
    updatedUsers User[] @relation("UserUpdater")

    @@index([email])
    @@index([groupId])
    @@index([userStatus])
    @@index([parentId])
    @@index([accountType])
    @@index([createdBy])
}

/// Group — Role/permission group that users belong to
model Group {
    /// Unique UUID identifier
    id          String   @id @default(uuid())
    /// Group name (unique, e.g., "Admin", "Receptionist", "Doctor")
    name        String   @unique
    /// Description of the group's purpose
    description String?
    /// Timestamp when the record was created
    createdAt   DateTime @default(now())
    /// User ID who created this record
    createdBy   String?
    /// Timestamp of last update
    updatedAt   DateTime @updatedAt
    /// User ID who last updated this record
    updatedBy   String?

    users                User[]
    permissions          GroupModulePermission[]
    subModulePermissions GroupSubModulePermission[]
}

/// Module — Top-level application module (e.g., "Patients", "Billing", "Appointments")
model Module {
    /// Unique UUID identifier
    id          String   @id @default(uuid())
    /// Module name (unique)
    name        String   @unique
    /// Description of the module
    description String?
    /// Timestamp when the record was created
    createdAt   DateTime @default(now())
    /// Timestamp of last update
    updatedAt   DateTime @updatedAt

    subModules  SubModule[]
    permissions GroupModulePermission[]
}

/// SubModule — Action/sub-feature within a module (e.g., "Add", "Edit", "Delete")
model SubModule {
    /// Unique UUID identifier
    id          String  @id @default(uuid())
    /// FK to parent Module
    moduleId    String
    /// Action/sub-feature name (e.g., "Add", "Edit", "Delete", "Export")
    name        String
    /// Description of the sub-module action
    description String?

    module      Module                     @relation(fields: [moduleId], references: [id])
    permissions GroupSubModulePermission[]

    @@unique([moduleId, name])
}

/// GroupModulePermission — Grants a group access to a module
model GroupModulePermission {
    /// Unique UUID identifier
    id        String  @id @default(uuid())
    /// FK to Group
    groupId   String
    /// FK to Module
    moduleId  String
    /// Whether the group has access to this module
    hasAccess Boolean @default(true)

    group                Group                      @relation(fields: [groupId], references: [id])
    module               Module                     @relation(fields: [moduleId], references: [id])
    subModulePermissions GroupSubModulePermission[]

    @@unique([groupId, moduleId])
    @@index([groupId])
    @@index([moduleId])
}

/// GroupSubModulePermission — Grants a group permission for a specific sub-module action
model GroupSubModulePermission {
    /// Unique UUID identifier
    id                      String  @id @default(uuid())
    /// FK to Group
    groupId                 String
    /// FK to SubModule
    subModuleId             String
    /// Whether this action is allowed for the group
    allowed                 Boolean @default(false)
    /// FK to parent GroupModulePermission (optional link)
    groupModulePermissionId String?

    group                 Group                  @relation(fields: [groupId], references: [id])
    subModule             SubModule              @relation(fields: [subModuleId], references: [id])
    groupModulePermission GroupModulePermission? @relation(fields: [groupModulePermissionId], references: [id])

    @@unique([groupId, subModuleId])
    @@index([groupId])
    @@index([subModuleId])
}


/// Visit — Patient visit/encounter record
model Visit {
  /// Unique auto-incremented visit identifier
  visit_id         Int      @id @default(autoincrement())
  /// FK to Appointment (null for walk-in visits)
  appointment_id   Int?
  /// FK to Patient
  patient_id       Int
  /// Date and time of the visit
  visit_date       DateTime
  /// FK to Location/branch (optional)
  location_id      Int?
  /// FK to Doctor — attending doctor
  doctor_id        String
  /// Type of visit (e.g., "Consultation", "Follow-up", "Emergency")
  visit_type       String
  /// Patient's reason for visiting
  reason_for_visit String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  appointment   Appointment?    @relation(fields: [appointment_id], references: [appointment_id])
  patient       Patient         @relation(fields: [patient_id], references: [patient_id])
  doctor        Doctor?         @relation(fields: [doctor_id], references: [id])
  clinicalNotes ClinicalNotes[]
  prescriptions Prescription[]
  documents     VisitDocument[]
  dentalHPIs    DentalHPI[]
  invoices      Invoice[]

  @@index([appointment_id])
  @@index([patient_id])
  @@index([location_id])
  @@index([doctor_id])
  @@index([visit_date])
  @@index([status])
}

/// DentalHPI — Dental History of Present Illness record
model DentalHPI {
  /// Unique auto-incremented identifier
  hpi_id     Int     @id @default(autoincrement())
  /// FK to Visit
  visit_id   Int
  /// FK to Patient
  patient_id Int
  /// FK to Doctor (optional)
  doctor_id  String?

  /// Dentition type: "primary", "mixed", or "permanent"
  dentition_type String

  /// Teeth and surfaces selected — JSON object (e.g., {"18": ["center", "leftTop"], "17": ["center"]})
  teeth_surfaces Json

  /// Chief complaints — JSON array (e.g., ["toothache", "swelling", "cavity"])
  chief_complaints Json

  /// Pain/condition severity: "mild", "moderate", or "severe"
  severity String?

  /// Duration component — years
  duration_years  Int @default(0)
  /// Duration component — months
  duration_months Int @default(0)
  /// Duration component — weeks
  duration_weeks  Int @default(0)
  /// Duration component — days
  duration_days   Int @default(0)

  /// Additional clinical notes
  notes String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visit   Visit   @relation(fields: [visit_id], references: [visit_id])
  patient Patient @relation(fields: [patient_id], references: [patient_id])
  doctor  Doctor? @relation(fields: [doctor_id], references: [id])

  @@index([visit_id])
  @@index([patient_id])
  @@index([doctor_id])
  @@index([status])
}

/// VisitDocument — File/document attached to a visit
model VisitDocument {
  /// Unique auto-incremented document identifier
  document_id      Int     @id @default(autoincrement())
  /// FK to Visit
  visit_id         Int
  /// FK to Patient
  patient_id       Int
  /// FK to DocumentType master
  document_type_id Int
  /// Original uploaded file name
  file_name        String
  /// Relative storage path on disk
  file_path        String
  /// Description or caption for the document
  description      String?
  /// MIME type (e.g., "application/pdf", "image/jpeg")
  mime_type        String
  /// File size in bytes
  file_size        Int

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visit        Visit        @relation(fields: [visit_id], references: [visit_id])
  patient      Patient      @relation(fields: [patient_id], references: [patient_id])
  documentType DocumentType @relation(fields: [document_type_id], references: [document_type_id])

  @@index([visit_id])
  @@index([patient_id])
  @@index([document_type_id])
  @@index([status])
}

/// ClinicalNotes — Clinical documentation for a visit (text or audio-based)
model ClinicalNotes {
  /// Unique auto-incremented identifier
  cn_id                Int     @id @default(autoincrement())
  /// FK to Patient
  patient_id           Int
  /// FK to Appointment (optional)
  appointment_id       Int?
  /// FK to Visit
  visit_id             Int
  /// FK to Location (optional)
  location_id          Int?
  /// FK to Doctor — author of the notes
  doctor_id            String
  /// Notes input type: "text" or "audio"
  notes_type           String  @default("text")
  /// Rich-text editor notes content
  editor_notes         String?
  /// Audio transcription text (for audio notes)
  transcription        String?
  /// URL to the uploaded audio file
  audio_url            String?
  /// Number of transcription retry attempts
  retry_count          Int     @default(0)
  /// AI-generated SOAP notes stored as JSON
  ai_notes             String?
  /// Number of AI note generation retry attempts
  ai_notes_retry_count Int     @default(0)

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patient     Patient      @relation(fields: [patient_id], references: [patient_id])
  appointment Appointment? @relation(fields: [appointment_id], references: [appointment_id])
  visit       Visit        @relation(fields: [visit_id], references: [visit_id])
  location    Location?    @relation(fields: [location_id], references: [location_id])
  doctor      Doctor       @relation(fields: [doctor_id], references: [id])

  @@index([patient_id])
  @@index([appointment_id])
  @@index([visit_id])
  @@index([doctor_id])
  @@index([location_id])
  @@index([status])
}

/// Prescription — Drug prescription line item for a visit
model Prescription {
  /// Unique auto-incremented prescription identifier
  prescription_id Int     @id @default(autoincrement())
  /// FK to Visit
  visit_id        Int
  /// FK to Appointment (optional)
  appointment_id  Int?
  /// FK to Patient
  patient_id      Int
  /// FK to Doctor (optional)
  doctor_id       String?

  // Drug Master Fields (Snapshot at prescription time)
  /// FK to Drug master (optional if custom drug)
  drug_id      Int?
  /// Drug brand/trade name (snapshot)
  drug_name    String
  /// Drug generic/chemical name (snapshot)
  drug_generic String?
  /// Drug type — Tablet, Capsule, Syrup, etc. (snapshot)
  drug_type    String?
  /// Drug dosage strength (snapshot)
  drug_dosage  String?
  /// Drug unit of measure (snapshot)
  drug_measure String?
  /// Usage instructions (snapshot)
  instruction  String?

  // Prescription Details
  /// Duration value (e.g., 7 for "7 days")
  duration      Int?
  /// Duration unit (e.g., "days", "weeks", "months")
  duration_type String?
  /// Total quantity to dispense
  quantity      Int?

  // Dosage Schedule
  /// Morning — before food
  morning_bf Boolean @default(false)
  /// Morning — after food
  morning_af Boolean @default(false)
  /// Noon — before food
  noon_bf    Boolean @default(false)
  /// Noon — after food
  noon_af    Boolean @default(false)
  /// Evening — before food
  evening_bf Boolean @default(false)
  /// Evening — after food
  evening_af Boolean @default(false)
  /// Night — before food
  night_bf   Boolean @default(false)
  /// Night — after food
  night_af   Boolean @default(false)

  /// Additional prescription notes
  notes String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visit       Visit        @relation(fields: [visit_id], references: [visit_id])
  appointment Appointment? @relation(fields: [appointment_id], references: [appointment_id])
  patient     Patient      @relation(fields: [patient_id], references: [patient_id])
  doctor      Doctor?      @relation(fields: [doctor_id], references: [id])
  drug        Drug?        @relation("PrescriptionDrug", fields: [drug_id], references: [drug_id])

  @@index([visit_id])
  @@index([appointment_id])
  @@index([patient_id])
  @@index([doctor_id])
  @@index([drug_id])
  @@index([status])
}

/// PrescriptionTemplate — Reusable prescription template
model PrescriptionTemplate {
  /// Unique auto-incremented identifier
