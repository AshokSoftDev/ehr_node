/// Visit — Patient visit/encounter record
model Visit {
  /// Unique auto-incremented visit identifier
  visit_id         Int      @id @default(autoincrement())
  /// FK to Appointment (null for walk-in visits)
  appointment_id   Int?
  /// FK to Patient
  patient_id       Int
  /// Date and time of the visit
  visit_date       DateTime
  /// FK to Location/branch (optional)
  location_id      Int?
  /// FK to Doctor — attending doctor
  doctor_id        String
  /// Type of visit (e.g., "Consultation", "Follow-up", "Emergency")
  visit_type       String
  /// Patient's reason for visiting
  reason_for_visit String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  appointment   Appointment?    @relation(fields: [appointment_id], references: [appointment_id])
  patient       Patient         @relation(fields: [patient_id], references: [patient_id])
  doctor        Doctor?         @relation(fields: [doctor_id], references: [id])
  clinicalNotes ClinicalNotes[]
  prescriptions Prescription[]
  documents     VisitDocument[]
  dentalHPIs    DentalHPI[]
  invoices      Invoice[]
  vitals        PatientVital[]

  @@index([appointment_id])
  @@index([patient_id])
  @@index([location_id])
  @@index([doctor_id])
  @@index([visit_date])
  @@index([status])
}

/// DentalHPI — Dental History of Present Illness record
model DentalHPI {
  /// Unique auto-incremented identifier
  hpi_id     Int     @id @default(autoincrement())
  /// FK to Visit
  visit_id   Int
  /// FK to Patient
  patient_id Int
  /// FK to Doctor (optional)
  doctor_id  String?

  /// Dentition type: "primary", "mixed", or "permanent"
  dentition_type String

  /// Teeth and surfaces selected — JSON object (e.g., {"18": ["center", "leftTop"], "17": ["center"]})
  teeth_surfaces Json

  /// Chief complaints — JSON array (e.g., ["toothache", "swelling", "cavity"])
  chief_complaints Json

  /// Pain/condition severity: "mild", "moderate", or "severe"
  severity String?

  /// Duration component — years
  duration_years  Int @default(0)
  /// Duration component — months
  duration_months Int @default(0)
  /// Duration component — weeks
  duration_weeks  Int @default(0)
  /// Duration component — days
  duration_days   Int @default(0)

  /// Additional clinical notes
  notes String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visit   Visit   @relation(fields: [visit_id], references: [visit_id])
  patient Patient @relation(fields: [patient_id], references: [patient_id])
  doctor  Doctor? @relation(fields: [doctor_id], references: [id])

  @@index([visit_id])
  @@index([patient_id])
  @@index([doctor_id])
  @@index([status])
}

/// VisitDocument — File/document attached to a visit
model VisitDocument {
  /// Unique auto-incremented document identifier
  document_id      Int     @id @default(autoincrement())
  /// FK to Visit
  visit_id         Int?
  /// FK to Patient
  patient_id       Int
  /// FK to DocumentType master
  document_type_id Int
  /// Original uploaded file name
  file_name        String
  /// Relative storage path on disk
  file_path        String
  /// Description or caption for the document
  description      String?
  /// MIME type (e.g., "application/pdf", "image/jpeg")
  mime_type        String
  /// File size in bytes
  file_size        Int

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visit        Visit?       @relation(fields: [visit_id], references: [visit_id])
  patient      Patient      @relation(fields: [patient_id], references: [patient_id])
  documentType DocumentType @relation(fields: [document_type_id], references: [document_type_id])

  @@index([visit_id])
  @@index([patient_id])
  @@index([document_type_id])
  @@index([status])
}

/// ClinicalNotes — Clinical documentation for a visit (text or audio-based)
model ClinicalNotes {
  /// Unique auto-incremented identifier
  cn_id                Int     @id @default(autoincrement())
  /// FK to Patient
  patient_id           Int
  /// FK to Appointment (optional)
  appointment_id       Int?
  /// FK to Visit
  visit_id             Int
  /// FK to Location (optional)
  location_id          Int?
  /// FK to Doctor — author of the notes
  doctor_id            String
  /// Notes input type: "text" or "audio"
  notes_type           String  @default("text")
  /// Rich-text editor notes content
  editor_notes         String?
  /// Audio transcription text (for audio notes)
  transcription        String?
  /// URL to the uploaded audio file
  audio_url            String?
  /// Number of transcription retry attempts
  retry_count          Int     @default(0)
  /// AI-generated SOAP notes stored as JSON
  ai_notes             String?
  /// Number of AI note generation retry attempts
  ai_notes_retry_count Int     @default(0)

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patient     Patient      @relation(fields: [patient_id], references: [patient_id])
  appointment Appointment? @relation(fields: [appointment_id], references: [appointment_id])
  visit       Visit        @relation(fields: [visit_id], references: [visit_id])
  location    Location?    @relation(fields: [location_id], references: [location_id])
  doctor      Doctor       @relation(fields: [doctor_id], references: [id])

  @@index([patient_id])
  @@index([appointment_id])
  @@index([visit_id])
  @@index([doctor_id])
  @@index([location_id])
  @@index([status])
}

/// Prescription — Drug prescription line item for a visit
model Prescription {
  /// Unique auto-incremented prescription identifier
  prescription_id Int     @id @default(autoincrement())
  /// FK to Visit
  visit_id        Int
  /// FK to Appointment (optional)
  appointment_id  Int?
  /// FK to Patient
  patient_id      Int
  /// FK to Doctor (optional)
  doctor_id       String?

  // Drug Master Fields (Snapshot at prescription time)
  /// FK to Drug master (optional if custom drug)
  drug_id      Int?
  /// Drug brand/trade name (snapshot)
  drug_name    String
  /// Drug generic/chemical name (snapshot)
  drug_generic String?
  /// Drug type — Tablet, Capsule, Syrup, etc. (snapshot)
  drug_type    String?
  /// Drug dosage strength (snapshot)
  drug_dosage  String?
  /// Drug unit of measure (snapshot)
  drug_measure String?
  /// Usage instructions (snapshot)
  instruction  String?

  // Prescription Details
  /// Duration value (e.g., 7 for "7 days")
  duration      Int?
  /// Duration unit (e.g., "days", "weeks", "months")
  duration_type String?
  /// Total quantity to dispense
  quantity      Int?

  // Dosage Schedule
  /// Morning — before food
  morning_bf Boolean @default(false)
  /// Morning — after food
  morning_af Boolean @default(false)
  /// Noon — before food
  noon_bf    Boolean @default(false)
  /// Noon — after food
  noon_af    Boolean @default(false)
  /// Evening — before food
  evening_bf Boolean @default(false)
  /// Evening — after food
  evening_af Boolean @default(false)
  /// Night — before food
  night_bf   Boolean @default(false)
  /// Night — after food
  night_af   Boolean @default(false)

  /// Additional prescription notes
  notes String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visit       Visit        @relation(fields: [visit_id], references: [visit_id])
  appointment Appointment? @relation(fields: [appointment_id], references: [appointment_id])
  patient     Patient      @relation(fields: [patient_id], references: [patient_id])
  doctor      Doctor?      @relation(fields: [doctor_id], references: [id])
  drug        Drug?        @relation("PrescriptionDrug", fields: [drug_id], references: [drug_id])

  @@index([visit_id])
  @@index([appointment_id])
  @@index([patient_id])
  @@index([doctor_id])
  @@index([drug_id])
  @@index([status])
}

/// PrescriptionTemplate — Reusable prescription template
model PrescriptionTemplate {
  /// Unique auto-incremented identifier
  temp_id       Int    @id @default(autoincrement())
  /// Template group identifier (groups multiple drugs into one template)
  template_id   BigInt
  /// Template display name
  template_name String

  // Drug Master Fields (Snapshot)
  /// FK to Drug master (optional if custom drug)
  drug_id      Int?
  /// Drug brand/trade name (snapshot)
  drug_name    String
  /// Drug generic/chemical name (snapshot)
  drug_generic String?
  /// Drug type — Tablet, Capsule, Syrup, etc. (snapshot)
  drug_type    String?
  /// Drug dosage strength (snapshot)
  drug_dosage  String?
  /// Drug unit of measure (snapshot)
  drug_measure String?
  /// Usage instructions (snapshot)
  instruction  String?

  // Prescription Details
  /// Duration value (e.g., 7 for "7 days")
  duration      Int?
  /// Duration unit (e.g., "days", "weeks", "months")
  duration_type String?
  /// Total quantity to dispense
  quantity      Int?

  // Dosage Schedule
  /// Morning — before food
  morning_bf Boolean @default(false)
  /// Morning — after food
  morning_af Boolean @default(false)
  /// Noon — before food
  noon_bf    Boolean @default(false)
  /// Noon — after food
  noon_af    Boolean @default(false)
  /// Evening — before food
  evening_bf Boolean @default(false)
  /// Evening — after food
  evening_af Boolean @default(false)
  /// Night — before food
  night_bf   Boolean @default(false)
  /// Night — after food
  night_af   Boolean @default(false)

  /// Additional notes
  notes String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  drug Drug? @relation("PrescriptionTemplateDrug", fields: [drug_id], references: [drug_id])

  @@index([template_id])
  @@index([drug_id])
  @@index([status])
}
