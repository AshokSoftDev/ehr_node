/// Patient — Core patient demographic record
model Patient {
  /// Unique auto-incremented patient identifier
  patient_id    Int       @id @default(autoincrement())
  /// Medical Record Number — unique across the system
  mrn           String    @unique
  /// Title (e.g., "Mr", "Mrs", "Dr")
  title         String
  /// First name
  firstName     String
  /// Last name
  lastName      String
  /// Date of birth (optional)
  dateOfBirth   DateTime?
  /// Age in years (may be manually entered if DOB unknown)
  age           Int?
  /// Gender (e.g., "Male", "Female", "Other")
  gender        String
  /// Primary mobile/phone number
  mobileNumber  String
  /// Street address
  address       String
  /// Area / locality
  area          String
  /// City
  city          String
  /// State / province
  state         String
  /// Country
  country       String
  /// Postal / PIN code
  pincode       String
  /// Aadhaar number (Indian national ID, optional)
  aadhar        String?
  /// Referral source (e.g., "Walk-in", "Doctor referral", "Online")
  referalSource String?
  /// General comments or notes about the patient
  comments      String?
  /// Record status: 1 = active, 0 = inactive
  activeStatus  Int       @default(1)
  /// Timestamp when the record was created
  createdAt     DateTime  @default(now())
  /// User ID who created this record
  createdBy     String
  /// Timestamp of last update
  updatedAt     DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy     String

  // Relations
  appointments     Appointment[]
  visits           Visit[]
  patientAllergies PatientAllergy[]
  patientInfo      PatientInfo?
  patientEmergency PatientEmergency[]
  clinicalNotes    ClinicalNotes[]
  prescriptions    Prescription[]
  visitDocuments   VisitDocument[]
  dentalHPIs       DentalHPI[]
  invoices         Invoice[]
  receipts         Receipt[]
  advances         PatientAdvance[]
  vitals                 PatientVital[]
  patientPmhs            PatientPmh[]
  patientFamilyHistories PatientFamilyHistory[]
  patientSocialHistories PatientSocialHistory[]
}

/// PatientAllergy — Records a patient's allergy information
model PatientAllergy {
  /// Unique auto-incremented identifier
  id          Int     @id @default(autoincrement())
  /// FK to Patient
  patient_id  Int
  /// FK to Allergy master (optional if custom allergy name)
  allergy_id  Int?
  /// Name of the allergy (may differ from master if custom)
  allergyName String
  /// Additional notes about the allergy
  notes       String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patient Patient  @relation(fields: [patient_id], references: [patient_id])
  allergy Allergy? @relation(fields: [allergy_id], references: [allergy_id])

  @@index([patient_id])
  @@index([allergy_id])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// PatientPmh — Records a patient's past medical history
model PatientPmh {
  /// Unique auto-incremented identifier
  id          Int     @id @default(autoincrement())
  /// FK to Patient
  patient_id  Int
  /// FK to PMH master
  pmh_id      Int
  /// Month of diagnosis
  month       Int?
  /// Year of diagnosis
  year        Int?
  /// Additional comments/notes
  comments    String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patient Patient @relation(fields: [patient_id], references: [patient_id])
  pmh     Pmh     @relation(fields: [pmh_id], references: [pmh_id])

  @@index([patient_id])
  @@index([pmh_id])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// PatientFamilyHistory — Records a patient's family medical history for a disease
model PatientFamilyHistory {
  /// Unique auto-incremented identifier
  id                Int           @id @default(autoincrement())
  /// FK to Patient
  patient_id        Int
  /// FK to FamilyDisease master
  family_disease_id Int

  /// Mother affected
  mother            Boolean       @default(false)
  /// Father affected
  father            Boolean       @default(false)
  /// Sister(s) affected
  sisters           Boolean       @default(false)
  /// Brother(s) affected
  brothers          Boolean       @default(false)
  /// Maternal Mother (Grandmother) affected
  maternalMother    Boolean       @default(false)
  /// Maternal Father (Grandfather) affected
  maternalFather    Boolean       @default(false)
  /// Paternal Mother (Grandmother) affected
  paternalMother    Boolean       @default(false)
  /// Paternal Father (Grandfather) affected
  paternalFather    Boolean       @default(false)
  /// Other relative(s) input text
  otherRelatives    String?
  /// Additional comments/notes
  comments          String?

  /// Record status: 1 = active, 0 = inactive
  status            Int           @default(1)
  /// Timestamp when the record was created
  createdAt         DateTime      @default(now())
  /// User ID who created this record
  createdBy         String?
  /// Timestamp of last update
  updatedAt         DateTime      @updatedAt
  /// User ID who last updated this record
  updatedBy         String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt         DateTime?
  /// User ID who soft-deleted this record
  deletedBy         String?

  // Relations
  patient       Patient       @relation(fields: [patient_id], references: [patient_id])
  familyDisease FamilyDisease @relation(fields: [family_disease_id], references: [family_disease_id])

  @@index([patient_id])
  @@index([family_disease_id])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// PatientSocialHistory — Records a patient's social history option choice for a condition
model PatientSocialHistory {
  /// Unique auto-incremented identifier
  id               Int          @id @default(autoincrement())
  /// FK to Patient
  patient_id       Int
  /// FK to SocialMaster
  social_master_id Int
  /// Selected option: 1 = option1, 2 = option2, null = not selected/unanswered
  selectedOption   Int?
  /// Additional comments/notes
  comments         String?

  /// Record status: 1 = active, 0 = inactive
  status           Int          @default(1)
  /// Timestamp when the record was created
  createdAt        DateTime     @default(now())
  /// User ID who created this record
  createdBy        String?
  /// Timestamp of last update
  updatedAt        DateTime     @updatedAt
  /// User ID who last updated this record
  updatedBy        String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt        DateTime?
  /// User ID who soft-deleted this record
  deletedBy        String?

  // Relations
  patient      Patient      @relation(fields: [patient_id], references: [patient_id])
  socialMaster SocialMaster @relation(fields: [social_master_id], references: [social_master_id])

  @@index([patient_id])
  @@index([social_master_id])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// PatientInfo — Extended patient information (one-to-one with Patient)
model PatientInfo {
  /// Unique auto-incremented identifier
  pi_id           Int       @id @default(autoincrement())
  /// FK to Patient (unique — one record per patient)
  patient_id      Int       @unique
  /// Blood group (e.g., "A+", "O-", "AB+")
  bloodGroup      String?
  /// Whether the patient is an overseas/international patient
  overseas        Boolean?
  /// Passport number (for overseas patients)
  passportNumber  String?
  /// Passport validity date
  validityDate    DateTime?
  /// Patient's occupation
  occupation      String?
  /// Department (if employed)
  department      String?
  /// Company / employer name
  companyName     String?
  /// Job designation / title
  designation     String?
  /// Employee code / ID
  employeeCode    String?
  /// FK to Doctor — the patient's primary/assigned doctor
  primaryDoctorId String?
  /// Record status: 1 = active, 0 = inactive
  activeStatus    Int       @default(1)
  /// Timestamp when the record was created
  createdAt       DateTime  @default(now())
  /// User ID who created this record
  createdBy       String?
  /// Timestamp of last update
  updatedAt       DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy       String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt       DateTime?
  /// User ID who soft-deleted this record
  deletedBy       String?

  patient Patient @relation(fields: [patient_id], references: [patient_id])
  doctor  Doctor? @relation(fields: [primaryDoctorId], references: [id])

  @@index([patient_id])
  @@index([primaryDoctorId])
  @@index([activeStatus])
}

/// PatientEmergency — Emergency contact for a patient
model PatientEmergency {
  /// Unique auto-incremented identifier
  pe_id         Int       @id @default(autoincrement())
  /// FK to Patient
  patient_id    Int
  /// Emergency contact person's name
  name          String
  /// Relationship to patient (e.g., "Spouse", "Parent", "Sibling")
  relation      String
  /// Emergency contact phone number
  contactNumber String
  /// Indicates if this is the primary emergency contact
  isPrimary     Boolean   @default(false)
  /// Record status: 1 = active, 0 = inactive
  status        Int       @default(1)
  /// Timestamp when the record was created
  createdAt     DateTime  @default(now())
  /// User ID who created this record
  createdBy     String?
  /// Timestamp of last update
  updatedAt     DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy     String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt     DateTime?
  /// User ID who soft-deleted this record
  deletedBy     String?

  patient Patient @relation(fields: [patient_id], references: [patient_id])

  @@index([patient_id])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// PatientVital — Records patient vital signs
model PatientVital {
  vital_id         Int      @id @default(autoincrement())
  patient_id       Int
  visit_id         Int?
  vital_date       DateTime
  vital_time       String?
  weight           Decimal?
  weight_unit      String   @default("kg")
  height           Decimal?
  height_unit      String   @default("cm")
  bmi              Decimal?
  temperature      Decimal?
  temperature_unit String   @default("celsius")
  pulse            Int?
  rr               Int?
  bp_systolic      Int?
  bp_diastolic     Int?

  status    Int       @default(1)
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  patient Patient @relation(fields: [patient_id], references: [patient_id])
  visit   Visit?  @relation(fields: [visit_id], references: [visit_id])

  @@index([patient_id])
  @@index([visit_id])
  @@index([status])
}
