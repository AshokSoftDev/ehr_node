// Master data models: Insurance, Allergy, Location, Drug, DocumentType

/// Insurance — Insurance policy master record
model Insurance {
  /// Unique auto-incremented identifier
  i_id           Int      @id @default(autoincrement())
  /// Insurance type (e.g., "Health", "Dental", "Life")
  type           String
  /// Insurance company name
  company        String
  /// Policy plan name
  policy         String
  /// Policy number
  policyNo       String
  /// Policy validity start date
  validationFrom DateTime
  /// Policy validity end date
  validationTo   DateTime
  /// Additional notes
  notes          String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Allergy — Allergy master record
model Allergy {
  /// Unique auto-incremented allergy identifier
  allergy_id  Int    @id @default(autoincrement())
  /// Name of the allergy (e.g., "Penicillin", "Peanuts")
  allergyName String
  /// Category/type of allergy (e.g., "Drug", "Food", "Environmental")
  allergyType String

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patientAllergies PatientAllergy[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Pmh — Past Medical History master record
model Pmh {
  /// Unique auto-incremented PMH identifier
  pmh_id        Int    @id @default(autoincrement())
  /// Name of the past medical history condition
  conditionName String
  /// Additional notes
  notes         String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patientPmhs PatientPmh[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Location — Clinic/branch location
model Location {
  /// Unique auto-incremented location identifier
  location_id   Int             @id @default(autoincrement())
  /// Location/branch name
  location_name String
  /// Street address
  address       String?
  /// City
  city          String
  /// State / province
  state         String
  clinicalNotes ClinicalNotes[]

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Whether the location is currently active (boolean flag)
  active    Boolean   @default(true)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  @@index([status])
  @@index([active])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Drug — Drug/medication master record
model Drug {
  /// Unique auto-incremented drug identifier
  drug_id      Int     @id @default(autoincrement())
  /// Generic/chemical name of the drug
  drug_generic String
  /// Brand/trade name of the drug
  drug_name    String
  /// Type of drug (e.g., "Tablet", "Capsule", "Syrup", "Injection")
  drug_type    String
  /// Dosage strength (e.g., "500", "250")
  drug_dosage  String
  /// Unit of measure (e.g., "mg", "ml", "g")
  drug_measure String
  /// Price per unit
  amount       Decimal @default(0)
  /// Default usage instructions (e.g., "Take after food")
  instruction  String?

  prescriptions         Prescription[]         @relation("PrescriptionDrug")
  prescriptionTemplates PrescriptionTemplate[] @relation("PrescriptionTemplateDrug")

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// DocumentType — Master list of document types for visit uploads
model DocumentType {
  /// Unique auto-incremented identifier
  document_type_id Int     @id @default(autoincrement())
  /// Document type name (e.g., "X-Ray", "Lab Report", "Consent Form") — unique
  type_name        String  @unique
  /// Description of the document type
  description      String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  visitDocuments VisitDocument[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// MasterAppointmentType — Master list of appointment types
model MasterAppointmentType {
  /// Unique auto-incremented identifier
  id               Int     @id @default(autoincrement())
  /// Appointment type code (e.g., "NEW_PATIENT")
  code             String  @unique
  /// Appointment type name
  name             String
  /// Description
  description      String?
  /// Default duration in minutes
  duration_minutes Int     @default(30)
  /// Color code for UI display
  color_code       String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// FamilyDisease — Family history disease master record
model FamilyDisease {
  /// Unique auto-incremented identifier
  family_disease_id Int    @id @default(autoincrement())
  /// Name of the family disease condition (e.g. "Diabetes", "Hypertension")
  diseaseName       String
  /// Additional notes
  notes             String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patientFamilyHistories PatientFamilyHistory[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// SocialMaster — Social history condition master record
model SocialMaster {
  /// Unique auto-incremented identifier
  social_master_id Int    @id @default(autoincrement())
  /// Name of the social habit/condition (e.g. "Smoking Status", "Alcohol Use")
  socialName       String
  /// Option 1 label (e.g. "Yes", "Current", "Regular")
  option1          String
  /// Option 2 label (e.g. "No", "Former", "Never")
  option2          String
  /// Additional notes (optional)
  notes            String?

  /// Record status: 1 = active, 0 = inactive
  status    Int       @default(1)
  /// Timestamp when the record was created
  createdAt DateTime  @default(now())
  /// User ID who created this record
  createdBy String?
  /// Timestamp of last update
  updatedAt DateTime  @updatedAt
  /// User ID who last updated this record
  updatedBy String?
  /// Soft-delete timestamp (null = not deleted)
  deletedAt DateTime?
  /// User ID who soft-deleted this record
  deletedBy String?

  // Relations
  patientSocialHistories PatientSocialHistory[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}
